&share
 wrf_core             = 'ARW'
 max_dom              = 4
 start_date           = '2025-05-29_00:00:00', '2025-05-29_00:00:00', '2025-05-29_00:00:00', '2025-05-29_00:00:00'
 end_date             = '2025-05-30_00:00:00', '2025-05-30_00:00:00', '2025-05-30_00:00:00', '2025-05-30_00:00:00'
 interval_seconds     = 21600
 io_form_geogrid      = 2
 debug_level          = 0
/

&geogrid
 parent_id            = 1, 1, 2, 3
 parent_grid_ratio    = 1, 3, 3, 3
 i_parent_start       = 1, 6, 6, 11
 j_parent_start       = 1, 6, 6, 11
 e_we                 = 19, 25, 43, 70
 e_sn                 = 19, 25, 43, 76
 geog_data_res        = 'default', 'default', 'default', 'default'
 dx                   = 27000
 dy                   = 27000
 map_proj             = 'mercator'
 ref_lat              = -7.501
 ref_lon              = 112.739
 truelat1             = -7.501
 pole_lat             = 90
 pole_lon             = 0
 geog_data_path       = 'WPS_GEOG'
 opt_geogrid_tbl_path = './geogrid/'
/

&ungrib
 out_format           = 'WPS'
 prefix               = 'FNL'
/

&metgrid
 fg_name              = 'FNL'
 io_form_metgrid      = 2
 opt_metgrid_tbl_path = './metgrid'
/

