&time_control
 run_days                = 1,
 run_hours               = 0,
 run_minutes             = 0,
 run_seconds             = 0,

 start_year              = 2025, 2025, 2025, 2025,
 start_month             = 05,   05,   05,   05,
 start_day               = 29,   29,   29,   29,
 start_hour              = 00,   00,   00,   00,
 start_minute            = 00,   00,   00,   00,
 start_second            = 00,   00,   00,   00,

 end_year                = 2025, 2025, 2025, 2025,
 end_month               = 05,   05,   05,   05,
 end_day                 = 30,   30,   30,   30,
 end_hour                = 00,   00,   00,   00,
 end_minute              = 00,   00,   00,   00,
 end_second              = 00,   00,   00,   00,

 interval_seconds        = 21600,    ! 3 jam (GFS f000, f003, f006)
 input_from_file         = .true., .true., .true., .true.,
 history_interval        = 60,   60,   60,   60,    ! output tiap 1 jam
 frames_per_outfile      = 1000, 1000, 1000, 1000, ! semua frame (6 jam) dalam 1 file per domain

 restart                 = .false.,
 restart_interval        = 1440,
 write_hist_at_0h_rst    = .false.,
 write_input             = .false.,

 io_form_history         = 2,
 io_form_restart         = 2,
 io_form_input           = 2,
 io_form_boundary        = 2,
/

&domains
 time_step               = 120,      ! dt D1; D4 dt = 162/27 ≈ 6 s (aman untuk dx=1 km)
 time_step_fract_num     = 0,
 time_step_fract_den     = 1,

 max_dom                 = 4,

 e_we                    = 19,  25,  43,  70,
 e_sn                    = 19,  25,  43,  76,
 e_vert                  = 40,  40,  40,  40,      ! misal 40 level vertikal
 p_top_requested         = 5000,

 num_metgrid_levels      = 34,
 num_metgrid_soil_levels = 4,

 dx                      = 27000, 9000, 3000, 1000,
 dy                      = 27000, 9000, 3000, 1000,

 grid_id                 = 1,   2,   3,   4,
 parent_id               = 1,   1,   2,   3,
 parent_grid_ratio       = 1,   3,   3,   3,
 parent_time_step_ratio  = 1,   3,   3,   3,

 i_parent_start          = 1,  6,  6,  11,
 j_parent_start          = 1,  6,  6,  11,

 feedback                = 1,
 smooth_option           = 0,
/

&physics
 mp_physics              = 6,  6,  6,  6,    ! WSM6 (aman, selalu tersedia)
 ra_lw_physics           = 4,  4,  4,  4,    ! RRTMG LW
 ra_sw_physics           = 4,  4,  4,  4,    ! RRTMG SW
 radt                    = 30, 30, 30, 30,

 sf_sfclay_physics       = 1,  1,  1,  1,    ! MM5 Similarity
 sf_surface_physics      = 2,  2,  2,  2,    ! Noah LSM
 bl_pbl_physics          = 5,  5,  5,  5,    ! YSU PBL

 cu_physics              = 1,  1,  0,  0,    ! Kain-Fritsch di domain kasar, OFF di D3 & D4
 cu_rad_feedback         = .true., .true., .false., .false.,
 cudt                    = 5,   5,   0,   0,

 isfflx                  = 1,
 ifsnow                  = 0,
 icloud                  = 1,
 num_soil_layers         = 4,
 surface_input_source    = 1,
 sf_urban_physics        = 0,
 sst_update              = 0,
/

&fdda
/

&dynamics
 w_damping               = 0,
 diff_opt                = 1,
 km_opt                  = 4,

 base_temp               = 290.,
 damp_opt                = 0,
 zdamp                   = 5000., 5000., 5000., 5000.,
 dampcoef                = 0.2,   0.2,   0.2,   0.2,

 khdif                   = 0,     0,     0,     0,
 kvdif                   = 0,     0,     0,     0,

 non_hydrostatic         = .true., .true., .true., .true.,
 moist_adv_opt           = 1,     1,     1,     1,
 scalar_adv_opt          = 1,     1,     1,     1,
/

&bdy_control
 spec_bdy_width          = 5,
 spec_zone               = 1,
 relax_zone              = 4,
 specified               = .true., .false., .false., .false.,
 nested                  = .false., .true.,  .true.,  .true.,
/

&grib2
/

&namelist_quilt
 nio_tasks_per_group     = 0,
 nio_groups              = 1,
/

&chem
 chem_opt = 0,
/
